{
  "name": "unic-ai-desktop",
  "productName": "UniC AI",
  "version": "1.0.0",
  "private": true,
  "description": "UniC AI pour Windows",
  "author": "UniC Plaquiste",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.unicplaquiste.ai.desktop",
    "productName": "UniC AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "app-dist"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "UniC-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
