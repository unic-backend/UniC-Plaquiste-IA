# UniC AI — configuration
# Copy to .env and adapt. Never commit real secrets.

UNIC_ENV=production
UNIC_DATA_DIR=./data
UNIC_HOST=0.0.0.0
UNIC_PORT=8000

# Database: sqlite by default (file under DATA_DIR). PostgreSQL is supported.
# DATABASE_URL=postgresql+psycopg://unic:unic@db:5432/unic

# Propriétaire unique (app solo, sans connexion)
UNIC_ADMIN_EMAIL=proprietaire@unic.local
UNIC_ADMIN_NAME=Administrateur UniC

# Optional cloud AI (OpenAI-compatible)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Raisonnement profond (Claude) — utilisé SEULEMENT quand tu cliques ✦ ou écris « réfléchis en profondeur »
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          (✦ raisonnement profond)
# ANTHROPIC_FAST_MODEL=claude-sonnet-5-5    (usage courant si Claude est le seul moteur)
# WEB_SEARCH_ENABLED=true                   (recherche Internet par Claude ; facturée à l'usage)
# WEB_SEARCH_MAX_USES=3                     (recherches maximum par réponse)

# Vibecode (https://vibecode.moe) — relais compatible Anthropic, fournisseur SECONDAIRE (mêmes modèles Claude).
# Priorité : Anthropic officiel d'abord. Vibecode n'est essayé que si Anthropic échoue (quota épuisé,
# clé refusée, réseau/panne) ou n'est pas configuré ; si Vibecode échoue aussi → secours local (PC / LOCAL_AI_URL).
# Doc : https://vibecode.moe/setup/cc  ·  modèles vérifiés « online » : https://vibecode.moe/models
# VIBECODE_API_KEY=vk-...                   (clé Vibecode, préfixe vk-)
# VIBECODE_BASE_URL=https://vibecode.moe    (ne PAS ajouter /v1 : le SDK l'ajoute lui-même)
# VIBECODE_SONNET_MODEL=claude-sonnet-5-5   (tâches quotidiennes, programmation, rédaction)
# VIBECODE_OPUS_MODEL=claude-opus-5-5       (✦ raisonnement et problèmes complexes)
# VIBECODE_HAIKU_MODEL=claude-haiku-4-5     (voix rapide ; vide = retombe sur Sonnet)
# VIBECODE_ENABLED=true                     (false = désactive le relais, Anthropic seul)
# AI_QUOTA_COOLDOWN_S=300                   (après un quota épuisé chez Anthropic, attente en secondes
#                                             avant de le réessayer ; 0 = réessayer à chaque message)

# Optional local AI (OpenAI-compatible server on the workshop PC)
# LOCAL_AI_URL=http://192.168.1.50:11434/v1
# LOCAL_AI_MODEL=llama3.1

# Optional embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small

# Email connector (leave empty = NOT AVAILABLE)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=            (défaut : SMTP_USER)
# IMAP_PASSWORD=        (défaut : SMTP_PASSWORD ; Gmail : mot de passe d'application)
# SMTP_FROM=

# Public URL used in download links (set to your VPS / domain)
UNIC_PUBLIC_URL=

# Fiche Google (Business Profile API) — voir README « Connecter la fiche Google »
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GBP_ACCOUNT_ID=
# GBP_LOCATION_ID=

# Origines autorisées par le CORS, séparées par des virgules (ex. https://unic-ai.onrender.com).
# Vide en production = aucune origine externe (l'appli servie par le serveur marche toujours).
# ALLOWED_ORIGINS=

# Redis (optionnel) : compteur d'essais de connexion partagé. Vide = mémoire du serveur.
# REDIS_URL=redis://redis:6379/0   (profil prod de docker-compose)
# DOMAIN=ia.unicplaquiste.com        (HTTPS automatique, profil prod)

# Coupe-circuit IA : false = aucun appel à Claude/OpenAI/modèle local (calculs, documents et PDF restent disponibles).
# LLM_ENABLED=true
